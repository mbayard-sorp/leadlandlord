# dependencies
node_modules/
.pnpm-store/

# build
.next/
.turbo/
dist/
build/
out/
*.tsbuildinfo

# Don't gitignore source `build` route segments (the operator app has
# /operator/build and /api/operator/build pages that the broader `build/`
# rule above would otherwise eat).
!apps/operator/app/operator/build/
!apps/operator/app/api/operator/build/

# env
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
.vscode/
.idea/
*.swp
*.swo

# os
.DS_Store
Thumbs.db

# vercel
.vercel/

# tmp
tmp/
.tmp/

# generated tenant-site builds
.llbuild/

# media
*.mp3
*.mp4
*.mov

# coverage
coverage/
.nyc_output/
