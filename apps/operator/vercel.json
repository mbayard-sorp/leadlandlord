{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @leadlandlord/operator vercel-build",
  "crons": [
    { "path": "/api/cron/tick", "schedule": "*/10 * * * *" },

    { "path": "/api/cron/schedule/tenant-prospector", "schedule": "0 14 * * 1" },
    { "path": "/api/cron/schedule/outreach-agent", "schedule": "0 15 * * *" },
    { "path": "/api/cron/schedule/trial-manager", "schedule": "0 16 * * *" },
    { "path": "/api/cron/schedule/billing-dunning", "schedule": "0 17 * * *" },
    { "path": "/api/cron/schedule/churn-recovery", "schedule": "30 17 * * *" },

    { "path": "/api/cron/schedule/lighthouse-audit", "schedule": "0 7 * * 1" },
    { "path": "/api/cron/schedule/seo-operator", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/schedule/content-freshness", "schedule": "0 8 * * *" },
    { "path": "/api/cron/schedule/seo-ingest-gsc", "schedule": "0 6 * * *" },
    { "path": "/api/cron/schedule/seo-ingest-ga4", "schedule": "15 6 * * *" },

    { "path": "/api/cron/schedule/maintenance", "schedule": "0 7 * * 1,3,5,6" },
    { "path": "/api/cron/schedule/portfolio-analyst", "schedule": "0 18 * * 5" },
    { "path": "/api/cron/schedule/molly-digest", "schedule": "0 14 * * *" },

    { "path": "/api/cron/schedule/niche-calibrator", "schedule": "0 9 * * 1" },
    { "path": "/api/cron/schedule/niche-prior-suggester", "schedule": "0 9 * * 2" },
    { "path": "/api/cron/schedule/niche-keyword-refresher", "schedule": "0 5 1 */3 *" },

    { "path": "/api/cron/schedule/local-content-scout", "schedule": "0 9 * * *" },

    { "path": "/api/cron/schedule/network-metrics-aggregator", "schedule": "0 4 * * 1,3,5" },
    { "path": "/api/cron/schedule/network-link-requests", "schedule": "0 5 * * *" },
    { "path": "/api/cron/schedule/geo-aeo-auditor", "schedule": "0 6 * * *" },
    { "path": "/api/cron/schedule/local-seo-optimizer", "schedule": "0 6 * * 2" },
    { "path": "/api/cron/schedule/data-inputs-scaffolder", "schedule": "30 8 * * 2" },
    { "path": "/api/cron/schedule/content-data-auditor", "schedule": "0 10 * * 3" },

    { "path": "/api/cron/schedule/buildsell-review-refresh", "schedule": "0 8 1 * *" },

    { "path": "/api/cron/backups", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "app/api/cron/agent/[name]/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/schedule/[name]/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/tick/route.ts": {
      "maxDuration": 800
    }
  }
}
