{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/operator-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/domain-verifier",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "app/api/cron/agent/[name]/route.ts": {
      "maxDuration": 300
    }
  }
}
