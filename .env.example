# ────────────────────────────────────────────────────────────
# LeadLandlord — Phase 0/1 environment variables
# Copy this file to .env.local and fill in real values.
# ────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────

# Neon Postgres (provisioned via Vercel Marketplace).
# Phase 1 dry-run will run migrations against this DB.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Anthropic API key. Used by all agents via @anthropic-ai/claude-agent-sdk.
# Default model: claude-sonnet-4-6. Estimated cost per dry-run: $1–2.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel personal/team token with `deploy` + `read-write projects` scopes.
# Used by Site Builder to create one Vercel project per tenant site.
VERCEL_TOKEN=

# Operator dashboard password (single-user MVP auth).
OPERATOR_PASSWORD=

# Random 32+ char secret for HMAC-signing the operator session cookie
# AND for signing internal cron→agent fan-out requests.
# Generate with: openssl rand -hex 32
OPERATOR_SESSION_SECRET=

# ── OPTIONAL ───────────────────────────────────────────────

# Vercel team ID (omit for personal account deploys).
VERCEL_TEAM_ID=

# Twilio Programmable Voice + Messaging credentials. If either ACCOUNT_SID or
# AUTH_TOKEN is unset, Tracking Setup falls back to a deterministic mock
# number and the operator dashboard flags it as "mock". TWILIO_FROM_NUMBER is
# the operator-owned outbound number used for SMS notifications + cold
# outreach (Phase 2/6).
# Console → https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Force Tracking Setup into mock mode even when Twilio creds are set.
# The Phase 1 dry-run script sets this automatically.
MOCK_TELEPHONY=true

# Operator notification destinations — where /api/lead sends SMS + email
# whenever a lead-form submission lands. Both optional; missing values
# silently skip that channel.
OPERATOR_PHONE_NUMBER=
OPERATOR_EMAIL=

# Resend (transactional email). Verify a sender at https://resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="LeadLandlord <leads@yourdomain.com>"

# Klaviyo private API key (pk_live_... or sk_...). Used by /api/lead to
# upsert profiles + subscribe to per-niche-city lists, and by Site Builder
# to create those lists at site-creation time.
KLAVIYO_PRIVATE_API_KEY=

# Sentry DSN. If unset, error tracking is disabled (logs only).
SENTRY_DSN=

# Public app URL for the operator dashboard. Used by the cron dispatcher
# to fan out HTTP calls to /api/cron/agent/[name].
# In dev: http://localhost:3000
# In prod: https://your-operator.vercel.app
OPERATOR_PUBLIC_URL=http://localhost:3000

# Daily LLM spend cap across all agents combined (USD).
# Hard stops new agent runs once exceeded.
DAILY_LLM_BUDGET_USD=20

# Vercel AI Gateway API key. Used by Site Builder to generate one hero image
# per site via Google Imagen (or whichever model you set in IMAGEN_MODEL).
# Get one at https://vercel.com/dashboard/ai-gateway → "Create API key".
# If unset, hero image generation is skipped and variants render their
# placeholder backgrounds.
AI_GATEWAY_API_KEY=

# Imagen model on AI Gateway. Default: google/imagen-3-fast.
# Other options: google/imagen-3-generate, google/imagen-4-generate-preview.
IMAGEN_MODEL=google/imagen-3-fast

# Alternative path: Google AI Studio direct (skips the Gateway hop).
# Get a key at https://aistudio.google.com/apikey. If GOOGLE_API_KEY is set
# AND AI_GATEWAY_API_KEY is unset, Site Builder uses this instead.
GOOGLE_API_KEY=
GOOGLE_IMAGEN_MODEL=imagen-3.0-fast-generate-001

# ── Sanity (multi-tenant CMS — Phase A onward) ─────────────────────
# Single Sanity project, two datasets (production + development).
# https://sanity.io/manage/personal/project/ybdv5za2

# Project ID for the LeadLandlord Sanity workspace.
SANITY_PROJECT_ID=ybdv5za2
# Active dataset for the operator/agent runtime. Use `production` in prod,
# `development` for local Site Builder dry-runs against the dev dataset.
SANITY_DATASET=production
# Server-only write token (Sanity → Manage → API → Tokens). Required by
# Site Builder for createOrReplace + asset uploads. NEVER expose client-side.
SANITY_API_TOKEN=
# 32-byte random hex secret. Required by site-host /api/revalidate to verify
# the Sanity webhook signature on content-change events.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Mirrored as NEXT_PUBLIC_* for client-side Sanity fetches in site-host (next-sanity).
NEXT_PUBLIC_SANITY_PROJECT_ID=ybdv5za2
NEXT_PUBLIC_SANITY_DATASET=production

# Vercel project ID of the multi-tenant `leadlandlord-sites` project.
# Operator uses this for the Vercel Domains API (attach/verify per-tenant domains).
# Set after the first deploy of apps/site-host.
VERCEL_SITES_PROJECT_ID=

# Public URL of the operator app — used by site-host /api/lead to proxy
# lead submissions back to the operator pipeline.
OPERATOR_PUBLIC_URL=https://leadlandlord-operator.vercel.app

# ── Per-tenant-site env (baked into each Vercel project) ──────────
# These are NOT set on the operator app — they're injected into each
# tenant site's Vercel project by Site Builder at deploy time. Listed
# here so the dry-run / local site-template builds know what they read.

# Canonical URL for the site (e.g. https://gutter-cleaning-boise.com/).
# When unset, falls back to https://$VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Optional: site identifier used as a GA4 custom dimension when a single
# central GA4 property serves the whole portfolio.
NEXT_PUBLIC_SITE_ID=

# Google Analytics 4 measurement ID (G-XXXXXXX). When set, the site emits
# the gtag bootstrap on every page; when unset, GA injection is skipped.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Block all crawlers — set to 'true' while a site is in warming mode and
# serving placeholder copy. Robots.txt becomes Disallow: / and the layout
# emits noindex,nofollow. Default: indexable.
NEXT_PUBLIC_ROBOTS_DISALLOW_ALL=

# Where the lead form posts. Site Builder bakes the operator app's URL into
# each tenant site so cross-origin form posts work. Falls back to /api/lead
# for local dev when the operator app and tenant site share an origin.
NEXT_PUBLIC_LEAD_API_URL=

# Site UUID + slug — used by /api/lead to attribute the submission.
# NEXT_PUBLIC_SITE_ID is the sites.id row, NEXT_PUBLIC_SITE_SLUG is the
# vercel project name (niche-city) used as a backup.
NEXT_PUBLIC_SITE_ID=
NEXT_PUBLIC_SITE_SLUG=
