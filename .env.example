# ────────────────────────────────────────────────────────────
# LeadLandlord — environment variables
# Copy this file to .env.local at the repo root and fill in real values.
# ────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────

# Neon Postgres (provisioned via Vercel Marketplace).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Anthropic API key. Used by all agents via the plain @anthropic-ai/sdk client
# (packages/integrations/src/anthropic.ts), wrapped by the in-house BaseAgent runtime.
# Default model: claude-sonnet-4-6. Estimated cost per Site Builder run: $0.20–$0.40.
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — read-only Neon role for the agent improvement loop's telemetry
# script (scripts/fleet-metrics.ts; see docs/agent-improvement-loop.md).
# Omit locally: the script falls back to DATABASE_URL, and without either it
# degrades to repo-only analysis. Never grant this role write permissions.
# READONLY_DATABASE_URL=

# Vercel personal/team token with `read-write projects` + `domains` scopes.
# Used by the operator app for: Vercel Domains API (attach/verify custom
# domains for tenants), the domain-verifier cron, and one-off bootstrap
# scripts. NOT used per-tenant anymore — every site renders out of the
# shared `leadlandlord-sites` Vercel project.
VERCEL_TOKEN=

# Operator dashboard password (single-user MVP auth).
OPERATOR_PASSWORD=

# Random 32+ char secret for HMAC-signing the operator session cookie
# AND for signing internal cron→agent fan-out requests.
# Generate with: openssl rand -hex 32
OPERATOR_SESSION_SECRET=

# Public URL of the operator app — used by:
#   - the cron dispatcher to fan out HTTP calls to /api/cron/agent/[name]
#   - site-host's /api/lead to proxy submissions back to the operator pipeline
# In dev: http://localhost:3000
# In prod: https://leadlandlord-operator.vercel.app
OPERATOR_PUBLIC_URL=http://localhost:3000

# ── Sanity (multi-tenant CMS) ──────────────────────────────────────
# Single Sanity project, two datasets (production + development).
# https://sanity.io/manage/personal/project/ybdv5za2

# Project ID for the LeadLandlord Sanity workspace.
SANITY_PROJECT_ID=ybdv5za2
# Active dataset for the operator/agent runtime. `production` in prod,
# `development` for local dry-runs (scripts/dry-run.ts forces this).
SANITY_DATASET=production
# Server-only write token (Sanity → Manage → API → Tokens). Required by
# Site Builder for createOrReplace + asset uploads. NEVER expose client-side.
SANITY_API_TOKEN=
# 32-byte random hex secret. Reserved for the site-host /api/revalidate
# webhook signature (currently a no-op stub — wired up in Track C).
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Mirrored as NEXT_PUBLIC_* for client-side Sanity fetches in site-host.
NEXT_PUBLIC_SANITY_PROJECT_ID=ybdv5za2
NEXT_PUBLIC_SANITY_DATASET=production

# Vercel project ID of the multi-tenant `leadlandlord-sites` project.
# The operator uses this for the Vercel Domains API (attach/verify
# per-tenant domains) + the domain-verifier cron. Set after the first
# deploy of apps/site-host.
VERCEL_SITES_PROJECT_ID=

# ── OPTIONAL ───────────────────────────────────────────────

# Vercel team ID (omit for personal account deploys).
VERCEL_TEAM_ID=

# Twilio Programmable Voice + Messaging credentials. If either ACCOUNT_SID or
# AUTH_TOKEN is unset, Tracking Setup falls back to a deterministic mock
# number and the operator dashboard flags it as "mock". TWILIO_FROM_NUMBER is
# the operator-owned outbound number used for SMS notifications + cold
# outreach (Phase 6).
# Console → https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Force Tracking Setup into mock mode even when Twilio creds are set.
# scripts/dry-run.ts sets this automatically.
MOCK_TELEPHONY=true

# Operator notification destinations — where /api/lead sends SMS + email
# whenever a lead-form submission lands. Both optional; missing values
# silently skip that channel.
OPERATOR_PHONE_NUMBER=
OPERATOR_EMAIL=

# Resend (transactional email). Verify a sender at https://resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="LeadLandlord <leads@yourdomain.com>"

# Klaviyo private API key (pk_live_... or sk_...). Used by /api/lead to
# upsert profiles + subscribe to per-niche-city lists, and by Site Builder
# to create those lists at site-creation time.
KLAVIYO_PRIVATE_API_KEY=

# Sentry DSN. If unset, error tracking is disabled (logs only). Wired up
# in Track C (Phase 7 hardening).
SENTRY_DSN=

# Daily LLM spend cap across all agents combined (USD).
# Hard stops new agent runs once exceeded.
DAILY_LLM_BUDGET_USD=20

# ── Imagen (hero image generation) ─────────────────────────────────
# Hero image gen routes through one of two providers. Both optional;
# without either, Site Builder skips hero gen and variants render
# their placeholder backgrounds.

# Vercel AI Gateway API key.
# Get one at https://vercel.com/dashboard/ai-gateway → "Create API key".
AI_GATEWAY_API_KEY=
# Imagen model on AI Gateway. Default: bfl/flux-pro-1.1. Must be an
# image-only model compatible with the OpenAI-style /v1/images/generations
# endpoint — the Imagen 4 family (imagen-4.0-*) was retired by Google on
# 2026-08-17 and multimodal chat models like google/gemini-2.5-flash-image
# are NOT compatible with this endpoint (they require /v1/chat/completions).
IMAGEN_MODEL=bfl/flux-pro-1.1

# Alternative path: Google AI Studio direct (skips the Gateway hop, less
# noise in logs). Get a key at https://aistudio.google.com/apikey. When
# both keys are set, Site Builder prefers Google direct.
GOOGLE_API_KEY=
GOOGLE_IMAGEN_MODEL=gemini-2.5-flash-image

# Force a specific provider regardless of which keys are set:
# `google` or `ai-gateway`. Skips the fallback chain.
IMAGEN_PROVIDER=

# ── Cloudflare (Registrar + DNS) ────────────────────────────────────
# Used by Domain Procurer to search, register, and configure domains.
# API token must include: Account.Cloudflare Registrar:Edit, Zone:Edit,
# Zone.DNS:Edit. Generate at https://dash.cloudflare.com/profile/api-tokens.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Default registrant contact used for domain registration when the caller
# does not pass one explicitly. ICANN requires accurate WHOIS data; CF
# applies privacy/proxy by default (privacy: true).
CLOUDFLARE_REGISTRANT_FIRST_NAME=
CLOUDFLARE_REGISTRANT_LAST_NAME=
CLOUDFLARE_REGISTRANT_ADDRESS=
CLOUDFLARE_REGISTRANT_CITY=
CLOUDFLARE_REGISTRANT_STATE=
CLOUDFLARE_REGISTRANT_ZIP=
CLOUDFLARE_REGISTRANT_COUNTRY=US
CLOUDFLARE_REGISTRANT_PHONE=
CLOUDFLARE_REGISTRANT_EMAIL=
CLOUDFLARE_REGISTRANT_ORG=

# Set to 'true' to skip all real Cloudflare API calls and return synthetic
# results — used by scripts/dry-run.ts. MOCK_TELEPHONY=true also triggers
# this (the global "no spend" switch).
CLOUDFLARE_DRY_RUN=

# ── Namecheap (Registrar + DNS) ─────────────────────────────────────
# Used by Domain Procurer (the active registrar — Cloudflare's public
# Registrar API does not support new-domain registration). API access is
# enabled at: ap.www.namecheap.com → Profile → Tools → Namecheap API Access.
# CRITICAL: Namecheap requires the calling IP to be on a per-account
# allowlist, set on the same screen. Set NAMECHEAP_CLIENT_IP to that IP.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# When 'true' the integration calls api.sandbox.namecheap.com instead of
# production. Sandbox uses a separate account at namecheap.com/sandbox
# with the same auth shape but free registrations against fake registries.
NAMECHEAP_USE_SANDBOX=false

# When 'true' all Namecheap calls return synthetic data (search returns 5
# candidates, register returns a fake order). Decoupled from MOCK_TELEPHONY.
NAMECHEAP_DRY_RUN=false

# Comma-separated allowlist for candidate generation. Default `com,net` for
# SEO-trustworthy local-services sites.
NAMECHEAP_ALLOWED_TLDS=com,net

# Default registrant contact (ICANN-mandated). All four contact blocks
# (Registrant/Tech/Admin/AuxBilling) are populated with these values.
NAMECHEAP_REGISTRANT_FIRST_NAME=
NAMECHEAP_REGISTRANT_LAST_NAME=
NAMECHEAP_REGISTRANT_ORG=
NAMECHEAP_REGISTRANT_ADDRESS=
NAMECHEAP_REGISTRANT_CITY=
NAMECHEAP_REGISTRANT_STATE=
NAMECHEAP_REGISTRANT_ZIP=
NAMECHEAP_REGISTRANT_COUNTRY=US
NAMECHEAP_REGISTRANT_PHONE=
NAMECHEAP_REGISTRANT_EMAIL=

# ── Google Search Console + GA4 (shared service account) ──────────────
# Single service account JSON used by both Google Search Console
# (webmasters.readonly) and Google Analytics 4 Data API (analytics.readonly).
# Provide ONE of:
#   - GOOGLE_SERVICE_ACCOUNT_KEY_JSON: base64-encoded JSON, or raw JSON
#   - GOOGLE_SERVICE_ACCOUNT_KEY_PATH: absolute path to a JSON keyfile
# Grant the service account email "Restricted user" on each Search Console
# property and "Viewer" on each GA4 property you need to read.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Set to 'true' to skip real Google API calls and return synthetic data
# from getSearchAnalytics, listSites, and getGa4Metrics.
GOOGLE_DRY_RUN=

# ── PageSpeed Insights (lighthouse-audit agent) ────────────────────────
# Optional API key for the PageSpeed Insights v5 API. Without a key the
# endpoint still works for low volume but is aggressively rate-limited;
# with a key the free quota is 25k req/day.
# Get one at: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Set to 'true' to skip the real PSI fetch and return synthetic Lighthouse
# scores (perf=85, a11y=92, bp=90, seo=95). Used by scripts/dry-run.ts.
LIGHTHOUSE_DRY_RUN=

# ── US Census Bureau Data API (niche-hunter enrichment) ────────────────
# Free API key for the US Census Data API. Used by the bulk-enrichment
# script (packages/us-cities `pnpm enrich:census`) to overlay ACS 5-Year
# demographics (median income, home value, owner-occupancy, etc.) on the
# SimpleMaps city dataset. Optional at runtime — without the cache file
# the loader falls back to bare SimpleMaps rows.
# Get one at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# ── Observability: Sentry (Phase E) ────────────────────────────────────
# Public DSN — exposed to the browser by intent so client-side errors get
# captured. Server config uses the same DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Server-side auth token + org/project for source-map upload (only used
# when wrapping next.config with withSentryConfig — currently off).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_OPERATOR=
SENTRY_PROJECT_SITE_HOST=

# ── Alerts (Phase E) ───────────────────────────────────────────────────
# PagerDuty Events API v2 routing key. Without it the alert-evaluator
# logs in dry-run mode + records alert_events rows but never pages.
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_DRY_RUN=
# Slack incoming webhook for alerts (separate from the digest webhook
# so noisy alerts don't drown the daily digest channel). Falls back to
# SLACK_DIGEST_WEBHOOK_URL when unset.
SLACK_ALERTS_WEBHOOK_URL=

# ── Backups (Phase E) ──────────────────────────────────────────────────
# Vercel Blob token for backup uploads. When unset the backups cron still
# generates the tarball locally (visible in function logs) but skips
# upload. Add `@vercel/blob` to apps/operator and re-deploy to enable.
BLOB_READ_WRITE_TOKEN=
# Set to 'true' to bypass the site-builder compliance gate in dev. Logs
# a warning. NEVER set in production.
COMPLIANCE_GATE_DISABLED=

# ── Zoho agentic Email ─────────────────────────────────────
# Zoho MCP endpoint + creds for agent-driven outbound email. Off by default;
# the throttle helper enforces a per-mailbox daily cap with a warmup ramp.
ZOHO_MCP_URL=
ZOHO_ACCOUNT_ID=
ZOHO_DEFAULT_FROM=molly@leadslandlord.com
ZOHO_DAILY_SEND_CAP=50
ZOHO_WARMUP_SCHEDULE_JSON=
ZOHO_MCP_ENABLED=false

# CAN-SPAM postal address used in agent-drafted outbound mail.
LEADLANDLORD_POSTAL_ADDRESS="LeadLandlord, [PO Box], [City], [State] [Zip]"

# ── Build & Sell (B&S) spec-site line ────────────────────────────────────
# Google Cloud API key with Places API (New) enabled (lead search).
GOOGLE_PLACES_API_KEY=
# Per-request timeout (ms) for Places fetches.
GOOGLE_PLACES_TIMEOUT_MS=10000
# Minimum interval (ms) between Places requests (per-instance burst smoother).
GOOGLE_PLACES_MIN_INTERVAL_MS=250
# Hard per-UTC-day Places request cap — the real spend ceiling.
GOOGLE_PLACES_DAILY_CAP=500
# Per-build cost ceiling (USD) enforced mid-run in spec-site-builder.
BUILDSELL_PER_RUN_CAP_USD=0.50
# Default quoted price (USD) for a spec site (operator can override per build).
BUILDSELL_DEFAULT_PRICE_USD=
# Shared HMAC secret (min 32 bytes) that authorizes the buyer "Save my theme"
# write on a draft preview. Operator signs the preview link (?t=...), site-host
# verifies it. MUST be the SAME value in both the operator and site-host
# Vercel projects, or Save will 401.
BS_PREVIEW_HMAC_SECRET=
# Sanity write token used ONLY by site-host's /api/bs-theme/[id] route to patch
# the buyer's chosen theme + themeLocked on draft buildsellSite docs. Scope to
# buildsellSite writes. NEVER expose client-side. site-host project only.
BS_SANITY_WRITE_TOKEN=

# ── ElevenLabs (Conversational AI voice agent) ──────────────────────────
# Console → https://elevenlabs.io/app/settings/api-keys
# Used for outbound closer-agent calls (Phase 6, currently dormant) AND
# inbound AI lead call qualification (ADR 0031). If ELEVENLABS_API_KEY is
# unset (or MOCK_TELEPHONY=true), packages/integrations/src/elevenlabs
# returns deterministic mock responses so webhook flows stay testable.
ELEVENLABS_API_KEY=
# The single shared Conversational AI agent id (one agent, dynamic
# variables per call — see ADR 0031, NOT per-site agents).
ELEVENLABS_AGENT_ID=
# phone_number_id created when a Twilio number is imported into ElevenLabs'
# native Twilio integration. Used by closer-agent's outbound bridge.
ELEVENLABS_PHONE_NUMBER_ID=
# Voice id for synthesizeSpeech(); defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM)
# in code when unset.
ELEVENLABS_VOICE_ID=
# Shared secret configured on the ElevenLabs webhook(s) (conversation-init +
# post-call). Verifies the `ElevenLabs-Signature: t=...,v0=...` HMAC header.
# Optional locally; required before enabling any site's call_mode in prod.
ELEVENLABS_WEBHOOK_SECRET=
# Signs the 7-day `?t=` token on tenant-facing call-recording links
# (/api/tenant-recordings/[callId], ADR 0031 Phase D). Falls back to
# OPERATOR_SESSION_SECRET when unset.
TENANT_RECORDING_SECRET=
