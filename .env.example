# ────────────────────────────────────────────────────────────
# LeadLandlord — environment variables
# Copy this file to .env.local at the repo root and fill in real values.
# ────────────────────────────────────────────────────────────

# ── REQUIRED ───────────────────────────────────────────────

# Neon Postgres (provisioned via Vercel Marketplace).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Anthropic API key. Used by all agents via @anthropic-ai/claude-agent-sdk.
# Default model: claude-sonnet-4-6. Estimated cost per Site Builder run: $0.20–$0.40.
ANTHROPIC_API_KEY=sk-ant-...

# Vercel personal/team token with `read-write projects` + `domains` scopes.
# Used by the operator app for: Vercel Domains API (attach/verify custom
# domains for tenants), the domain-verifier cron, and one-off bootstrap
# scripts. NOT used per-tenant anymore — every site renders out of the
# shared `leadlandlord-sites` Vercel project.
VERCEL_TOKEN=

# Operator dashboard password (single-user MVP auth).
OPERATOR_PASSWORD=

# Random 32+ char secret for HMAC-signing the operator session cookie
# AND for signing internal cron→agent fan-out requests.
# Generate with: openssl rand -hex 32
OPERATOR_SESSION_SECRET=

# Public URL of the operator app — used by:
#   - the cron dispatcher to fan out HTTP calls to /api/cron/agent/[name]
#   - site-host's /api/lead to proxy submissions back to the operator pipeline
# In dev: http://localhost:3000
# In prod: https://leadlandlord-operator.vercel.app
OPERATOR_PUBLIC_URL=http://localhost:3000

# ── Sanity (multi-tenant CMS) ──────────────────────────────────────
# Single Sanity project, two datasets (production + development).
# https://sanity.io/manage/personal/project/ybdv5za2

# Project ID for the LeadLandlord Sanity workspace.
SANITY_PROJECT_ID=ybdv5za2
# Active dataset for the operator/agent runtime. `production` in prod,
# `development` for local dry-runs (scripts/dry-run.ts forces this).
SANITY_DATASET=production
# Server-only write token (Sanity → Manage → API → Tokens). Required by
# Site Builder for createOrReplace + asset uploads. NEVER expose client-side.
SANITY_API_TOKEN=
# 32-byte random hex secret. Reserved for the site-host /api/revalidate
# webhook signature (currently a no-op stub — wired up in Track C).
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
# Mirrored as NEXT_PUBLIC_* for client-side Sanity fetches in site-host.
NEXT_PUBLIC_SANITY_PROJECT_ID=ybdv5za2
NEXT_PUBLIC_SANITY_DATASET=production

# Vercel project ID of the multi-tenant `leadlandlord-sites` project.
# The operator uses this for the Vercel Domains API (attach/verify
# per-tenant domains) + the domain-verifier cron. Set after the first
# deploy of apps/site-host.
VERCEL_SITES_PROJECT_ID=

# ── OPTIONAL ───────────────────────────────────────────────

# Vercel team ID (omit for personal account deploys).
VERCEL_TEAM_ID=

# Twilio Programmable Voice + Messaging credentials. If either ACCOUNT_SID or
# AUTH_TOKEN is unset, Tracking Setup falls back to a deterministic mock
# number and the operator dashboard flags it as "mock". TWILIO_FROM_NUMBER is
# the operator-owned outbound number used for SMS notifications + cold
# outreach (Phase 6).
# Console → https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Force Tracking Setup into mock mode even when Twilio creds are set.
# scripts/dry-run.ts sets this automatically.
MOCK_TELEPHONY=true

# Operator notification destinations — where /api/lead sends SMS + email
# whenever a lead-form submission lands. Both optional; missing values
# silently skip that channel.
OPERATOR_PHONE_NUMBER=
OPERATOR_EMAIL=

# Resend (transactional email). Verify a sender at https://resend.com/domains.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="LeadLandlord <leads@yourdomain.com>"

# Klaviyo private API key (pk_live_... or sk_...). Used by /api/lead to
# upsert profiles + subscribe to per-niche-city lists, and by Site Builder
# to create those lists at site-creation time.
KLAVIYO_PRIVATE_API_KEY=

# Sentry DSN. If unset, error tracking is disabled (logs only). Wired up
# in Track C (Phase 7 hardening).
SENTRY_DSN=

# Daily LLM spend cap across all agents combined (USD).
# Hard stops new agent runs once exceeded.
DAILY_LLM_BUDGET_USD=20

# ── Imagen (hero image generation) ─────────────────────────────────
# Hero image gen routes through one of two providers. Both optional;
# without either, Site Builder skips hero gen and variants render
# their placeholder backgrounds.

# Vercel AI Gateway API key.
# Get one at https://vercel.com/dashboard/ai-gateway → "Create API key".
AI_GATEWAY_API_KEY=
# Imagen model on AI Gateway. Default: google/imagen-4.0-fast-generate-001.
IMAGEN_MODEL=google/imagen-4.0-fast-generate-001

# Alternative path: Google AI Studio direct (skips the Gateway hop, less
# noise in logs). Get a key at https://aistudio.google.com/apikey. When
# both keys are set, Site Builder prefers Google direct.
GOOGLE_API_KEY=
GOOGLE_IMAGEN_MODEL=imagen-4.0-fast-generate-001

# Force a specific provider regardless of which keys are set:
# `google` or `ai-gateway`. Skips the fallback chain.
IMAGEN_PROVIDER=

# ── Cloudflare (Registrar + DNS) ────────────────────────────────────
# Used by Domain Procurer to search, register, and configure domains.
# API token must include: Account.Cloudflare Registrar:Edit, Zone:Edit,
# Zone.DNS:Edit. Generate at https://dash.cloudflare.com/profile/api-tokens.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Default registrant contact used for domain registration when the caller
# does not pass one explicitly. ICANN requires accurate WHOIS data; CF
# applies privacy/proxy by default (privacy: true).
CLOUDFLARE_REGISTRANT_FIRST_NAME=
CLOUDFLARE_REGISTRANT_LAST_NAME=
CLOUDFLARE_REGISTRANT_ADDRESS=
CLOUDFLARE_REGISTRANT_CITY=
CLOUDFLARE_REGISTRANT_STATE=
CLOUDFLARE_REGISTRANT_ZIP=
CLOUDFLARE_REGISTRANT_COUNTRY=US
CLOUDFLARE_REGISTRANT_PHONE=
CLOUDFLARE_REGISTRANT_EMAIL=
CLOUDFLARE_REGISTRANT_ORG=

# Set to 'true' to skip all real Cloudflare API calls and return synthetic
# results — used by scripts/dry-run.ts. MOCK_TELEPHONY=true also triggers
# this (the global "no spend" switch).
CLOUDFLARE_DRY_RUN=

# ── Google Search Console + GA4 (shared service account) ──────────────
# Single service account JSON used by both Google Search Console
# (webmasters.readonly) and Google Analytics 4 Data API (analytics.readonly).
# Provide ONE of:
#   - GOOGLE_SERVICE_ACCOUNT_KEY_JSON: base64-encoded JSON, or raw JSON
#   - GOOGLE_SERVICE_ACCOUNT_KEY_PATH: absolute path to a JSON keyfile
# Grant the service account email "Restricted user" on each Search Console
# property and "Viewer" on each GA4 property you need to read.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Set to 'true' to skip real Google API calls and return synthetic data
# from getSearchAnalytics, listSites, and getGa4Metrics.
GOOGLE_DRY_RUN=

# ── PageSpeed Insights (lighthouse-audit agent) ────────────────────────
# Optional API key for the PageSpeed Insights v5 API. Without a key the
# endpoint still works for low volume but is aggressively rate-limited;
# with a key the free quota is 25k req/day.
# Get one at: https://console.cloud.google.com/apis/credentials
PAGESPEED_API_KEY=

# Set to 'true' to skip the real PSI fetch and return synthetic Lighthouse
# scores (perf=85, a11y=92, bp=90, seo=95). Used by scripts/dry-run.ts.
LIGHTHOUSE_DRY_RUN=
