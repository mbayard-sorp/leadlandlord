on">{"@context":"https://schema.org","@type":"WebSite","@id":"https://tesshauling.com/#website","name":"TESS Hauling & Cleanouts","url":"https://tesshauling.com/","publisher":{"@id":"https://tesshauling.com/#localbusiness"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Full Junk Removal","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"We haul away unwanted items of all sizes from anywhere on your property — garages, backyards, or curbside. No job is too big or too small.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Home Cleanouts","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"Clear out entire rooms, estates, or properties quickly and efficiently. Our junk removal team handles sorting, loading, and disposal so you don't have to.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Office & Commercial Cleanouts","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"Relocating or downsizing your Chandler business? We remove old furniture, equipment, and debris with minimal disruption to your operations.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Furniture & Appliance Pickup","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"Bulky sofas, mattresses, refrigerators — we safely remove and responsibly dispose of large items that curbside pickup won't take.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Construction Debris Removal","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"Post-renovation messes are no problem. We clear drywall, lumber scraps, tile, and other construction waste from your job site fast.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Eco-Friendly Disposal","provider":{"@id":"https://tesshauling.com/#localbusiness"},"description":"We sort loads for donation and recycling wherever possible, keeping usable items out of Chandler-area landfills and giving them a second life.","url":"https://tesshauling.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"AggregateOffer","offers":[{"@type":"Offer","name":"Mini Pickup","description":"1-2 Items","price":50,"priceCurrency":"USD"},{"@type":"Offer","name":"1 to 1.5 Load","description":"Fill the trailer up and then some","price":200,"priceCurrency":"USD"},{"@type":"Offer","name":"Small Cleanout","description":"Free up your space with a small clean out job","price":500,"priceCurrency":"USD"},{"@type":"Offer","name":"Medium Cleanout","description":"Up to 3 trailer loads","price":800,"priceCurrency":"USD"},{"@type":"Offer","name":"Large Clean Out","description":"3-4 loads fits in a 20-yard *dumpster rental","price":1200,"priceCurrency":"USD"},{"@type":"Offer","name":"Full House","description":"Complete house clean out or a heavy load","price":2000,"priceCurrency":"USD"},{"@type":"Offer","name":"Fridge / Freezer w/freon disposal","description":"Any appliance $50/per","price":100,"priceCurrency":"USD"}],"priceCurrency":"USD","lowPrice":50,"highPrice":2000}</script><main id="main"><div class="bs-root" data-bs-layout="trust" style="--bs-primary:#15803d;--bs-primary-dark:#14532d;--bs-accent:#d97706;--bs-on-primary:#ffffff;--bs-bg:#f5f8f4;--bs-surface:#ffffff;--bs-text:#14241a;--bs-muted:#5c6b5e;--bs-font-heading:var(--font-bs-poppins);--bs-font-body:var(--font-bs-inter)"><nav class="bs-nav" data-nav="true" aria-label="Site navigation"><div class="bs-container bs-nav-inner"><a