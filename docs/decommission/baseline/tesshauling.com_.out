dn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F4c778829670f4f100b8294444fa409f6e43cb18d-1384x1856.jpg&amp;w=3840&amp;q=75"/></div></div></div></section><section class="bs-section bs-reveal" id="about"><div class="bs-container"><div class="bs-about-trust"><p class="bs-section-eyebrow">Who We Are</p><h2 class="bs-section-title">Chandler&#x27;s Go-To Cleanout Specialists</h2><p class="bs-about-body">TESS Hauling &amp; Cleanouts LLC was built on a simple promise: show up on time, work hard, and leave your space cleaner than we found it. We proudly serve Chandler and the surrounding East Valley with honest, upfront pricing and a no-hassle experience from first call to final sweep. Whether you&#x27;re clearing a single room or an entire property, our team treats your home or business with the same care and respect we&#x27;d want for our own.</p><div class="bs-credential-pills"><span class="bs-credential-pill"><strong>5★</strong>Average customer rating</span><span class="bs-credential-pill"><strong>Same-Day</strong>Service available</span><span class="bs-credential-pill"><strong>500+</strong>Loads hauled</span><span class="bs-credential-pill"><strong>100%</strong>Satisfaction focus</span></div><a href="#contact" class="bs-btn bs-btn-primary bs-about-cta">Get a Free Quote<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="bs-cta-arrow"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a></div></div></section><section class="bs-section bs-section-alt bs-reveal" id="services"><div class="bs-container"><div class="bs-section-head"><p class="bs-section-eyebrow">What We Offer</p><h2 class="bs-section-title">What We Do</h2><p class="bs-section-intro">Quality work for every job, big or small.</p></div><div class="bs-services-compact"><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Full Junk Removal</a></h3><p class="bs-services-compact-desc">We haul away unwanted items of all sizes from anywhere on your property — garages, backyards, or curbside. No job is too big or too small.</p></div></div><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Home Cleanouts</a></h3><p class="bs-services-compact-desc">Clear out entire rooms, estates, or properties quickly and efficiently. Our junk removal team handles sorting, loading, and disposal so you don&#x27;t have to.</p></div></div><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Office &amp; Commercial Cleanouts</a></h3><p class="bs-services-compact-desc">Relocating or downsizing your Chandler business? We remove old furniture, equipment, and debris with minimal disruption to your operations.</p></div></div><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sofa" aria-hidden="true"><path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3"></path><path d="M2 16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"></path><path d="M4 18v2"></path><path d="M20 18v2"></path><path d="M12 4v9"></path></svg></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Furniture &amp; Appliance Pickup</a></h3><p class="bs-services-compact-desc">Bulky sofas, mattresses, refrigerators — we safely remove and responsibly dispose of large items that curbside pickup won&#x27;t take.</p></div></div><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hard-hat" aria-hidden="true"><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"></path><path d="M14 6a6 6 0 0 1 6 6v3"></path><path d="M4 15v-3a6 6 0 0 1 6-6"></path><rect x="2" y="15" width="20" height="4" rx="1"></rect></svg></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Construction Debris Removal</a></h3><p class="bs-services-compact-desc">Post-renovation messes are no problem. We clear drywall, lumber scraps, tile, and other construction waste from your job site fast.</p></div></div><div class="bs-services-compact-row"><div class="bs-icon-box bs-icon-box--sm" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-recycle" aria-hidden="true"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"></path><path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"></path><path d="m14 16-3 3 3 3"></path><path d="M8.293 13.596 7.196 9.5 3.1 10.598"></path><path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"></path><path d="m13.378 9.633 4.096 1.098 1.097-4.096"></path></svg></div><div><h3 class="bs-services-compact-title"><a href="#contact" class="bs-link">Eco-Friendly Disposal</a></h3><p class="bs-services-compact-desc">We sort loads for donation and recycling wherever possible, keeping usable items out of Chandler-area landfills and giving them a second life.</p></div></div></div></div></section><section class="bs-section bs-section-alt bs-reveal" id="how-it-works"><div class="bs-container"><div class="bs-section-head"><p class="bs-section-eyebrow">zero surprises</p><h2 class="bs-section-title">We offer simple, upfront, volume-based pricing—no surprises.</h2></div><div class="bs-process-trust" data-steps="3"><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg></div><h3 class="bs-process-step-title">How pricing works</h3><p class="bs-process-step-desc">Your price is based on how much space your items take up in the trailer/dumpster—not by time. Send us a photo or description for a fast, exact quote.</p></div><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path></svg></div><h3 class="bs-process-step-title">What’s included:  </h3><p class="bs-process-step-desc">Labor, loading, hauling, disposal</p></div><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-dollar-sign" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg></div><h3 class="bs-process-step-title">Additional charges may apply for: </h3><p class="bs-process-step-desc">Heavy materials (dirt, concrete, roofing) or extra-large or specialty items - same day service</p></div></div></div></section><section class="bs-section bs-reveal" id="reviews"><div class="bs-container"><div class="bs-section-head"><p class="bs-section-eyebrow">Customer Love</p><h2 class="bs-section-title">What Our Customers Say</h2></div><div class="bs-reviews-aggregate"><span class="bs-stars " role="img" aria-label="5 out of 5 stars"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg></span><span class="bs-rating-label">5.0<!-- --> / 5<!-- --> · 12 reviews</span></div><div class="bs-reviews-masonry"><div class="bs-review-card "><span class="bs-stars " role="img" aria-label="5 out of 5 stars"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg></span><p class="bs-review-text">“<!-- -->Had a great experience with Tess Hauling. Great price for the work performed, they have always come through for me.<!-- -->”</p><div class="bs-review-footer"><div class="bs-review-avatar" aria-hidden="true">JT</div><div><p class="bs-review-author">Jeff T.</p><p class="bs-review-location">Chandler, AZ</p><p class="bs-review-date">2026-06-23</p></div></div></div></div><div class="bs-reviews-cta"><a href="https://www.google.com/search?q=tess+hauling&amp;oq=tess+hauling&amp;gs_lcrp=EgZjaHJvbWUyBggAEEUYOTIGCAEQRRg8MgYIAhBFGDzSAQg1MDUyajBqNKgCALACAA&amp;sourceid=chrome&amp;ie=UTF-8&amp;zx=1782864951863#lrd=0x2e9b77bbb7b29391:0x88913837b0d2fe6a,3,,,," class="bs-btn bs-btn-primary bs-btn-lg">Leave a Review</a></div></div></section><section class="bs-section bs-section-alt bs-reveal" id="how-it-works"><div class="bs-container"><div class="bs-section-head"><p class="bs-section-eyebrow">Simple Steps</p><h2 class="bs-section-title">How It Works</h2></div><div class="bs-process-trust" data-steps="4"><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone-call" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path><path d="M14.05 2a9 9 0 0 1 8 7.94"></path><path d="M14.05 6A5 5 0 0 1 18 10"></path></svg></div><h3 class="bs-process-step-title">Request Your Quote</h3><p class="bs-process-step-desc">Reach out online or by phone and describe what you need hauled — we&#x27;ll provide a clear, upfront price with no hidden fees.</p></div><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-check" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="m9 16 2 2 4-4"></path></svg></div><h3 class="bs-process-step-title">Schedule a Pickup</h3><p class="bs-process-step-desc">Choose a time that works for you, including same-day appointments when availability allows, and we&#x27;ll confirm your booking right away.</p></div><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg></div><h3 class="bs-process-step-title">We Load &amp; Haul</h3><p class="bs-process-step-desc">Our crew arrives on time, loads every last item, and clears your space completely — you don&#x27;t lift a finger.</p></div><div class="bs-card bs-process-trust-card"><div class="bs-step-num" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg></div><h3 class="bs-process-step-title">Enjoy Your Clear Space</h3><p class="bs-process-step-desc">We do a final sweep of the area before we leave, so all that&#x27;s left is the clean, open space you&#x27;ve been waiting for.</p></div></div></div></section><section class="bs-section bs-reveal" id="pricing"><div class="bs-container"><div class="bs-section-head"><p class="bs-section-eyebrow">We offer simple, upfront, volume-based pricing—no surprises.</p><h2 class="bs-section-title">Pricing</h2><p class="bs-section-intro">T.E.S.S. Total Elimination Service Solutions</p></div><div class="bs-pricing-grid"><div class="bs-price-card"><h3 class="bs-price-name">Mini Pickup</h3><div class="bs-price-amount"><span class="amt">$50-$150</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">1-2 Items</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>No job is too small</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Small Pile</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div><div class="bs-price-card"><h3 class="bs-price-name">1 to 1.5 Load</h3><div class="bs-price-amount"><span class="amt">$200-$550</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">Fill the trailer up and then some</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Full Trailer</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Overflow</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div><div class="bs-price-card"><h3 class="bs-price-name">Small Cleanout</h3><div class="bs-price-amount"><span class="amt">$500-$700</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">Free up your space with a small clean out job</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Small Cleanout</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Reclaim your space!</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div><div class="bs-price-card bs-price-card--featured"><span class="bs-price-badge">Most Popular</span><h3 class="bs-price-name">Medium Cleanout</h3><div class="bs-price-amount"><span class="amt">$800-$1000</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">Up to 3 trailer loads</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>We take it away today</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Breathe a sigh of relief now it&#x27;s all gone</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-primary">Call for Quote</a></div><div class="bs-price-card"><h3 class="bs-price-name">Large Clean Out</h3><div class="bs-price-amount"><span class="amt">$1200-$1600</span><span class="unit">/flat rate</span></div><p class="bs-price-desc">3-4 loads fits in a 20-yard *dumpster rental</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Big job, junk gone</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>*Customer rents dumpster (we can help)</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div><div class="bs-price-card"><h3 class="bs-price-name">Full House</h3><div class="bs-price-amount"><span class="amt">$2000-$3500</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">Complete house clean out or a heavy load</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>5+ Loads</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Requires a 40-yard dumpster</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div><div class="bs-price-card"><h3 class="bs-price-name">Fridge / Freezer w/freon disposal</h3><div class="bs-price-amount"><span class="amt">$100</span><span class="unit">/flat-rate</span></div><p class="bs-price-desc">Any appliance $50/per</p><ul class="bs-price-features" role="list"><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Your old appliance, gone</span></li><li><svg class="bs-price-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Toxic material disposal</span></li></ul><a href="tel:6024132889 " class="bs-btn bs-btn-outline">Call for Quote</a></div></div><p class="bs-pricing-footnote">*We do not provide dumpster rentals. If we feel the size of the job requires a roll off dumpster, we will arrange the rental and include it in the price estimate.</p></div></section><section class="bs-section bs-section-dark bs-reveal" id="contact"><div class="bs-container"><div class="bs-contact-grid bs-contact-grid--trust"><div class="bs-contact-info bs-contact-info--dark"><h2 class="bs-section-title">Get Your Free Estimate Today</h2><p class="bs-section-intro">Ready to reclaim your space? Reach out and we&#x27;ll get you a fast, no-obligation quote — same-day service often available.</p><div class="bs-contact-details"><div class="bs-contact-detail"><span class="bs-contact-detail-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-phone" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></span><div class="bs-contact-detail-body"><span class="bs-contact-detail-label">Call us</span><div class="bs-contact-detail-value"><a href="tel:(602) 413-2889" class="bs-contact-detail-link">(602) 413-2889</a></div></div></div><div class="bs-contact-detail"><span class="bs-contact-detail-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg></span><div class="bs-contact-detail-body"><span class="bs-contact-detail-label">Visit</span><div class="bs-contact-detail-value"><div>2212 E Kempton Rd, Chandler, AZ 85225, USA</div><div>Chandler, AZ, 85225</div></div></div></div><div class="bs-contact-detail"><span class="bs-contact-detail-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span><div class="bs-contact-detail-body"><span class="bs-contact-detail-label">Hours</span><div class="bs-contact-detail-value">Mon–Sat 7am–6pm</div></div></div><div class="bs-contact-detail"><span class="bs-contact-detail-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map" aria-hidden="true"><path d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"></path><path d="M15 5.764v15"></path><path d="M9 3.236v15"></path></svg></span><div class="bs-contact-detail-body"><span clas