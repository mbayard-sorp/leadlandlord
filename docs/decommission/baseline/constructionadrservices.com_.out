description" content="Michael J. Bayard Construction ADR specializes in resolving construction disputes, ensuring project continuity and preserving relationships."/><meta property="og:url" content="https://constructionadrservices.com"/><meta property="og:site_name" content="Michael J. Bayard Construction ADR"/><meta property="og:image" content="https://constructionadrservices.com/cadr/og?cs=constructionadr"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Michael J. Bayard Construction ADR"/><meta name="twitter:description" content="Michael J. Bayard Construction ADR specializes in resolving construction disputes, ensuring project continuity and preserving relationships."/><meta name="twitter:image" content="https://constructionadrservices.com/cadr/og?cs=constructionadr"/><meta name="twitter:image:width" content="1200"/><meta name="twitter:image:height" content="630"/><script src="/_next/static/immutable/chunks/0c0hxoamwjsbw.js" noModule=""></script></head><body><div hidden=""><!--$--><!--/$--></div><a href="#main" class="skip-to-content">Skip to main content</a><div class="cs-adr -qoaIq_variable wyHUDG_variable"><a href="#main" class="cs-skip-link">Skip to main content</a><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://constructionadrservices.com/#website","name":"Michael J. Bayard Construction ADR","url":"https://constructionadrservices.com/","publisher":{"@id":"https://constructionadrservices.com/#organization"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"LegalService","@id":"https://constructionadrservices.com/#organization","name":"Michael J. Bayard Construction ADR","url":"https://constructionadrservices.com/","telephone":"(213) 383-9399","email":"michaeljbayard@yahoo.com","address":{"@type":"PostalAddress","streetAddress":"611 Wilshire Boulevard","addressLocality":"Los Angeles","addressRegion":"CA","postalCode":"90017","addressCountry":"US"},"areaServed":[{"@type":"City","name":"Los Angeles"}],"review":[{"@type":"Review","author":{"@type":"Person","name":"Marcia Kamine"},"reviewBody":"He's really a go-to person. If you're not serious, you don't go to Mike. He really wants to make things happen."},{"@type":"Review","author":{"@type":"Person","name":"Maria S."},"reviewBody":"Our business has relied on the expertise and exceptional service provided by Michael J. Bayard for many years, and they have consistently exceeded our expectations."},{"@type":"Review","author":{"@type":"Person","name":"Scott Green"},"reviewBody":"When there's a hot issue, Mike is writing seven days a week, multiple times a day, to ferret out the important information and determine what could help move the process forward.\n\nConstruction litigation is in Bayard's genes"},{"@type":"Review","author":{"@type":"Person","name":"Ted R. Gropman"},"reviewBody":"He's very quietly tenacious. He keeps working and working to try to get a matter resolved."}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","@id":"https://constructionadrservices.com/#attorney","name":"Michael J. Bayard","jobTitle":"Mediator, Arbitrator, Judicial Reference, Discovery Referee, ADR Advocacy Consultant","worksFor":{"@id":"https://constructionadrservices.com/#organization"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":"Michael J. Bayard Construction ADR site navigation","itemListElement":[{"@type":"SiteNavigationElement","position":1,"name":"Home","url":"https://constructionadrservices.com/"},{"@type":"SiteNavigationElement","position":2,"name":"Mike’s Story","url":"https://constructionadrservices.com/mikes-story"},{"@type":"SiteNavigationElement","position":3,"name":"ADR Services","url":"https://constructiona