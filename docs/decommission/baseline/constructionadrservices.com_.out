d preserving relationships.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\"https://constructionadrservices.com/cadr/og?cs=constructionadr\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}]]\n19:\"/_next/static/immutable/chunks/0j9644hl2p5r4.js\"\n1a:I[852940,[\"$7\",\"$14\",\"$19\"],\"Image\"]\n6:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://constructionadrservices.com/#webpage\\\",\\\"url\\\":\\\"https://constructionadrservices.com/\\\",\\\"name\\\":\\\"Michael J. Bayard Construction ADR\\\",\\\"description\\\":\\\"Michael J. Bayard Construction ADR specializes in resolving construction disputes, ensuring project continuity and preserving relationships.\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://constructionadrservices.com/#website\\\"}}\"}}],[[\"$\",\"section\",\"home-hero\",{\"className\":\"cs-hero\",\"id\":\"home\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-hero-bg\",\"children\":[[\"$\",\"$L1a\",null,{\"src\":\"https://cdn.sanity.io/images/ybdv5za2/production/d9c8557e8fc1ad0fbeecb39805f9172eb3ae8080-1920x1080.png?auto=format\u0026fit=max\u0026w=2048\u0026q=75\",\"alt\":\"Michael J. Bayard seated in his Los Angeles office\",\"fill\":true,\"priority\":true,\"sizes\":\"100vw\",\"style\":{\"objectFit\":\"cover\"}}],null]}],[\"$\",\"div\",null,{\"className\":\"cs-container cs-section\",\"style\":{\"position\":\"relative\",\"zIndex\":1},\"children\":[\"$\",\"div\",null,{\"className\":\"cs-hero-inner\",\"children\":[[\"$\",\"span\",null,{\"className\":\"cs-eyebrow cs-eyebrow--inverse\",\"children\":\"Michael J. Bayard\"}],[\"$\",\"h1\",null,{\"children\":\"Practice Limited to Construction Disputes\"}],[\"$\",\"p\",null,{\"className\":\"cs-hero-subheading\",\"children\":\"Mediator, Arbitrator, Judicial Reference, Discovery Referee, ADR Advocacy Consultant.\"}],[\"$\",\"div\",null,{\"className\":\"cs-hero-cta\",\"children\":[\"$\",\"a\",null,{\"href\":\"/contact\",\"className\":\"cs-btn cs-btn-primary\",\"children\":\"Talk to an Expert\"}]}]]}]}]]}],[\"$\",\"section\",\"home-intro\",{\"className\":\"cs-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-container\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-intro-grid\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-intro-aside\",\"data-cs-reveal\":true,\"children\":[[\"$\",\"span\",null,{\"className\":\"cs-eyebrow\",\"children\":\"about the firm\"}],[\"$\",\"h2\",null,{\"children\":\"Collaborative Solutions For Complex Disputes\"}]]}],[\"$\",\"div\",null,{\"data-cs-reveal\":true,\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-prose\",\"children\":[[\"$\",\"p\",\"b8711001456e\",{\"children\":[\"At Michael J. Bayard Construction ADR, we recognize the challenges that construction disputes can pose, often disrupting projects and straining relationships. With years of experience in the field, our team is well-versed in navigating the intricacies of construction law, making us adept at mediating and arbitrating even the most intricate disputes.\"]}],[\"$\",\"p\",\"19ac29555b69\",{\"children\":[\"Our commitment extends beyond legal expertise. We understand the value of maintaining ongoing projects and preserving relationships in the construction industry. Our approach combines legal acumen with a deep appreciation for the nuances of construction projects, enabling us to guide parties toward solutions that benefit all stakeholders.\"]}]]}],[\"$\",\"a\",null,{\"href\":\"/mikes-story\",\"className\":\"cs-link\",\"children\":[\"About the Firm\",[\"$\",\"span\",null,{\"className\":\"cs-link-arrow\",\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]]}]]}]}]}],\"$L1b\",[\"$\",\"section\",\"home-attorney\",{\"className\":\"cs-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-attorney\",\"children\":[[\"$\",\"div\",null,{\"className\":\"cs-attorney-photo\",\"children\":[\"$\",\"$L1a\",null,{\"src\":\"https://cdn.sanity.io/images/ybdv5za2/production/8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg?auto=format\u0026fit=max\u0026w=900\u0026q=75\",\"alt\":\"Portrait of Michael J. Bayard\",\"fill\":true,\"sizes\":\"(max-width: 899px) 100vw, 260px\",\"style\":{\"objectFit\":\"cover\"}}]}],[\"$\",\"div\",null,{\"className\":\"cs-attorney-body\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Michael J. Bayard\"}],[\"$\",\"p\",null,{\"className\":\"cs-lead\",\"children\":\"Mediator, Arbitrator, Judicial Reference, Discovery Referee, ADR Advocacy Consultant\"}],null,[\"$\",\"div\",null,{\"className\":\"cs-prose\",\"children\":[[\"$\",\"p\",\"ebacabb81eba\",{\"children\":[\"Michael Bayard has more than three decades of experience as a construction attorney. A full-time neutral since 2000, he has resolved hundreds of construction and real estate disputes ranging from small residential projects to high-profile, multi-million-dollar, multi-party cases. Mr. Bayard is a former Partner and Chair of the Construction Law Practice Groups at both Sonnenschein Nath \u0026 Rosenthal (now SNR Denton) and Pillsbury Madison \u0026 Sutro (now Pillsbury), where he specialized in complex matters valued in excess of $1 million. He is a nationally recognized authority on the drafting and negotiation of major construction-related documents.\"]}],\"$L1c\",\"$L1d\",\"$L1e\"]}],null,\"$L1f\"]}]]}],null]}]}],\"$L20\",\"$L21\",\"$L22\",\"$L23\"]]\n24:\"TestimonialsCarousel\"\n25:I[87626,[\"$7\",\"$14\",\"$19\"],\"$24\"]\n1c:[\"$\",\"h3\",\"c9e16a424b3f\",{\"children\":[\"Mr. Bayard was elected and serves on the California Lawyers Association, Practice Area Committee (PAC) in Construction Law:\"]}]\n1d:[\"$\",\"p\",\"cbabefc7ecd0\",{\"children\":[\"\\\"The Construction Law PAC is dedicated to providing education and community to the full scope of attorneys practicing in the field of construction law — from contractual disputes (including delay, disruption, acceleration, site conditions, etc.), to transactional matters involving construction contracts, to public contract procurement, to contractor licensing, to mechanic’s liens and stop notices, and even to construction-defect litigation. The Construction Law Practice Area Committee will further these objectives by generating and disseminating member-created content in the form of live webinars, case notes, Real Property Law Journal articles, and potentially in-person legal presentations to its membership.\\\"\"]}]\n1e:[\"$\",\"p\",\"5abac426e2c7\",{\"children\":[[\"$\",\"strong\",\"5a78f3a648c0\",{\"children\":[\"See article:\"]}],\" \",[\"$\",\"a\",\"7e2029d56d32\",{\"href\":\"https://calawyers.org/real-property-law/practice-area-group-journal-highlight-construction-law/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"cs-prose-url-link\",\"children\":\"calawyers.org/real-property-law/practic…\"}]]}]\n1f:[\"$\",\"p\",null,{\"style\":{\"marginTop\":24},\"children\":[\"$\",\"a\",null,{\"href\":\"/mikes-story\",\"className\":\"cs-link\",\"children\":[\"Attorney Profile\",[\"$\",\"span\",null,{\"className\":\"cs-link-arrow\",\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]}]\n20:[\"$\",\"section\",\"home-testimonials\",{\"className\":\"cs-section cs-section--navy\",\"children\":[\"$\",\"div\",null,{\"className\":\"cs-container\",\"children\":[\"$\",\"$L25\",null,{\"items\":[{\"_id\":\"cs-testimonial-constructionadr-maria-s-client\",\"author\":\"Maria S.\",\"quote\":\"Our business has relied on the expertise and exceptional service provided by Michael J. Bayard for many years, and they have consistently exceeded our expectations.\",\"rating\":null,\"role\":\"Client\"},{\"_id\":\"cs-testimonial-constructionadr-ted-r-gropman\",\"author\":\"Ted R. Gropman\",\"quote\":\"He's ver