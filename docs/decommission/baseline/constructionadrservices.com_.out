ages%2Fybdv5za2%2Fproduction%2Fd9c8557e8fc1ad0fbeecb39805f9172eb3ae8080-1920x1080.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D2048%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fd9c8557e8fc1ad0fbeecb39805f9172eb3ae8080-1920x1080.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D2048%26q%3D75&amp;w=3840&amp;q=75"/></div><div class="cs-container cs-section" style="position:relative;z-index:1"><div class="cs-hero-inner"><span class="cs-eyebrow cs-eyebrow--inverse">Michael J. Bayard</span><h1>Practice Limited to Construction Disputes</h1><p class="cs-hero-subheading">Mediator, Arbitrator, Judicial Reference, Discovery Referee, ADR Advocacy Consultant.</p><div class="cs-hero-cta"><a href="/contact" class="cs-btn cs-btn-primary">Talk to an Expert</a></div></div></div></section><section class="cs-section"><div class="cs-container"><div class="cs-intro-grid"><div class="cs-intro-aside" data-cs-reveal="true"><span class="cs-eyebrow">about the firm</span><h2>Collaborative Solutions For Complex Disputes</h2></div><div data-cs-reveal="true"><div class="cs-prose"><p>At Michael J. Bayard Construction ADR, we recognize the challenges that construction disputes can pose, often disrupting projects and straining relationships. With years of experience in the field, our team is well-versed in navigating the intricacies of construction law, making us adept at mediating and arbitrating even the most intricate disputes.</p><p>Our commitment extends beyond legal expertise. We understand the value of maintaining ongoing projects and preserving relationships in the construction industry. Our approach combines legal acumen with a deep appreciation for the nuances of construction projects, enabling us to guide parties toward solutions that benefit all stakeholders.</p></div><a href="/mikes-story" class="cs-link">About the Firm<span class="cs-link-arrow" aria-hidden="true">→</span></a></div></div></div></section><section class="cs-section" id="practice-areas"><div class="cs-container"><div class="cs-section-head" data-cs-reveal="true"><span class="cs-eyebrow">Our Expertise</span><h2>Practice Areas</h2></div><div class="cs-grid-3"><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="client and attorney handshake" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fa1036518f9637fde3cade9624316d73435a50035-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Construction Mediation</h3><p class="cs-card-excerpt">Bridging Differences For Project Success</p><a href="/practice-areas/construction-mediation" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="construction workers working on site" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F2999c49c7be60dabf05d7f51b2743e6cbae6e9e0-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Construction Arbitration</h3><p class="cs-card-excerpt">Arbitration is a formal process where a neutral arbitrator reviews evidence and issues a binding decision, providing a structured alternative to litigation.</p><a href="/practice-areas/construction-arbitration" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="three business owners talking to each other" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F89df284283bd175dfdd2e7c9a6352cb470801db9-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Construction Neutral Evaluation</h3><p class="cs-card-excerpt">We specialize in resolving contract-related disputes, whether they involve payment issues, scope changes, delays, or other contract matters.</p><a href="/practice-areas/construction-neutral-evaluation" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="construction site" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbf8268819bdc6bd7951922e38178c935244ea0b7-443x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Construction Defect Claims</h3><p class="cs-card-excerpt">Our expertise extends to resolving disputes related to construction defects, ensuring a fair and equitable resolution.</p><a href="/practice-areas/construction-defect-claims" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="construction site" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F0a0dd84bdf814f7416f570216fe70d053cb14589-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Design and Engineering Disputes</h3><p class="cs-card-excerpt">We assist in resolving disputes related to design and engineering issues, helping parties find solutions that adhere to industry standards.</p><a href="/practice-areas/design-and-engineering-disputes" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div><div class="cs-card" data-cs-reveal="true"><div class="cs-card-media"><img alt="construction site" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 360px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fe904498963ca5ab67dae641569abed77678d99ef-444x318.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D720%26q%3D75&amp;w=3840&amp;q=75"/></div><h3>Project Delay Claims</h3><p class="cs-card-excerpt">Timely project completion is vital in construction. Our ADR services address disputes arising from project delays to keep construction projects on track.</p><a href="/practice-areas/project-delay-claims" class="cs-link">Learn more<span class="cs-link-arrow" aria-hidden="true">→</span></a></div></div></div></section><section class="cs-section"><div class="cs-container"><div class="cs-attorney"><div class="cs-attorney-photo"><img alt="Portrait of Michael J. Bayard" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="(max-width: 899px) 100vw, 260px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F8c18db4a27ded92cca6700ed615ea0d84514f872-445x593.jpg%3Fauto%3Dformat%26fit%3Dmax%26w%3D900%26q%3D75&amp;w=3840&amp;q=75"/></div><div class="cs-attorney-body"><h2>Michael J. Bayard</h2><p class="cs-lead">Mediator, Arbitrator, Judicial Reference, Discovery Referee, ADR Advocacy Consultant</p><div class="cs-prose"><p>Michael Bayard has more than three decades of experience as a construction attorney. A full-time neutral since 2000, he has resolved hundreds of construction and real estate disputes ranging from small residential projects to high-profile, multi-million-dollar, multi-party cases. Mr. Bayard is a former Partner and Chair of the Construction Law Practice Groups at both Sonnenschein Nath &amp; Rosenthal (now SNR Denton) and Pillsbury Madison &amp; Sutro (now Pillsbury), where he specialized in complex matters valued in excess of $1 million. He is a nationally recognized authority on the drafting and negotiation of major construction-related documents.</p><h3>Mr. Bayard was elected and serves on the California Lawyers Association, Practice Area Committee (PAC) in Construction Law:</h3><p>&quot;The Construction Law PAC is dedicated to providing education and community to the full scope of attorneys practicing in the field of construction law — from contractual disputes (including delay, disruption, acceleration, site conditions, etc.), to transactional matters involving construction contracts, to public contract procurement, to contractor licensing, to mechanic’s liens and stop notices, and even to construction-defect litigation. The Construction Law Practice Area Committee will further these objectives by generating and disseminating member-created content in the form of live webinars, case notes, Real Property Law Journal articles, and potentially in-person legal presentations to its membership.&quot;</p><p><strong>See article:</strong> <a href="https://calawyers.org/real-property-law/practice-area-group-journal-highlight-construction-law/" target="_blank" rel="noopener noreferrer" class="cs-prose-url-link">calawyers.org/real-property-law/practic…</a></p></div><p style="margin-top:24px"><a href="/mikes-story" class="cs-link">Attorney Profile<span class="cs-link-arrow" aria-hidden="true">→</span></a></p></div></div></div></section><section class="cs-section cs-section--navy"><div class="cs-container"><div class="cs-testimonials"><div aria-live="off" aria-atomic="true"><div class="cs-testimonial-slide"><blockquote class="cs-testimonial-quote">“<!-- -->Our business has relied on the expertise and exceptional service provided by Michael J. Bayard for many years, and they have consistently exceeded our expectations.<!-- -->”</blockquote><p class="cs-testimonial-author">Maria S.<!-- -->, Client</p></div></div><div class="cs-testimonial-controls"><div class="cs-testimonial-dots" role="group" aria-label="Testimonials"><button type="button" class="cs-testimonial-dot" aria-current="true" aria-label="Show testimonial 1 of 4"></button><button type="button" class="cs-testimonial-dot" aria-current="false" aria-label="Show testimonial 2 of 4"></button><button type="button" class="cs-testimonial-dot" aria-current="false" aria-label="Show testimonial 3 of 4"></button><button type="button" class="cs-testimonial-dot" aria-current="false" aria-label="Show testimonial 4 of 4"></button></div><button type="button" class="cs-testimonial-playpause" aria-label="Pause testimonial rotation"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 2.5h3v11H4v-11zm5 0h3v11H9v-11z" fill="currentColor"></path></svg></button></div></div></div></section><section class="cs-section cs-badge-section"><div class="cs-container cs-badge-row"><span class="cs-badge-cell"><span class="cs-badge-img"><img alt="Lexis Nexis badge logo" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:contain;color:transparent" sizes="220px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F6301081573e55205a8a38eebc63a972f96c77759-219x85.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F6301081573e55205a8a38eebc63a972f96c77759-219x85.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2F6301081573e55205a8a38eebc63a972f96c77759-219x85.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=64&amp