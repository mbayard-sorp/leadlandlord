ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fybdv5za2%2Fproduction%2Fbbbb5104de7cf06ff8e6ff470199c18e1a873d28-202x51.png%3Fauto%3Dformat%26fit%3Dmax%26w%3D440%26q%3D75&amp;w=3840&amp;q=75"/></span></span></div></section><section class="cs-section"><div class="cs-container"><div class="cs-section-head" data-cs-reveal="true"><h2>Publications</h2></div><div><article class="cs-pub-card" data-cs-reveal="true"><p class="cs-pub-meta">Article</p><h3>What Happens If ADR Fails and the Dispute Moves Toward Litigation</h3><p class="cs-card-excerpt">Not every construction dispute resolves in the conference room. A mediation may end with both sides too far apart, a neutral evaluation may expose risk without producing agreement, or an…</p><a href="/what-happens-if-adr-fails-and-the-dispute-moves-toward-litigation" class="cs-link">Read<span class="cs-link-arrow" aria-hidden="true">→</span></a></article><article class="cs-pub-card" data-cs-reveal="true"><p class="cs-pub-meta">Article</p><h3>Statutes of Limitations and Timeliness When ADR Might Be Too Late</h3><p class="cs-card-excerpt">A construction dispute can feel manageable until the calendar becomes part of the problem. A payment disagreement, defect claim, design issue, or delay claim may sit unresolved while emails continue,…</p><a href="/statutes-of-limitations-and-timeliness-when-adr-might-be-too-late" class="cs-link">Read<span class="cs-link-arrow" aria-hidden="true">→</span></a></article><article class="cs-pub-card" data-cs-reveal="true"><p class="cs-pub-meta">Article</p><h3>Legal Standards for Enforcing Mediated Settlement Agreements in California</h3><p class="cs-card-excerpt">A mediated settlement can resolve a construction dispute without a trial, but the agreement must be drafted for enforcement from the start. California law gives mediation strong confidentiality protections, so…</p><a href="/legal-standards-for-enforcing-mediated-settlement-agreements-in-california" class="cs-link">Read<span class="cs-link-arrow" aria-hidden="true">→</span></a></article></div><p style="margin-top:24px"><a href="/publications" class="cs-btn cs-btn-secondary">View All Publications</a></p></div></section><section class="cs-section cs-section--muted" id="contact"><div class="cs-container"><div class="cs-contact-grid"><div><span class="cs-eyebrow">Get Your Free Case Review</span><h2>Let Us Help You</h2><div class="cs-reach-us"><span class="cs-eyebrow">Reach Us</span><dl><div><dt>Address:</dt><dd>611 Wilshire Boulevard<br/>9th Floor<br/>Los Angeles, CA, 90017</dd></div><div><dt>Phone:</dt><dd><a href="tel:(213) 383-9399">(213) 383-9399</a></dd></div><div><dt>Email:</dt><dd><a href="mailto:michaeljbayard@yahoo.com">michaeljbayard@yahoo.com</a></dd></div></dl><p class="cs-reach-us-note">We respond to every inquiry personally.</p></div></div><div class="cs-contact-form-panel"><form noValidate=""><div class="cs-form-row"><div class="cs-form-field"><label class="cs-form-label" for="cs-firstName">First name <span class="cs-form-required" aria-hidden="true">*</span></label><input id="cs-firstName" type="text" required="" class="cs-form-input" autoComplete="given-name" name="firstName"/></div><div class="cs-form-field"><label class="cs-form-label" for="cs-lastName">Last name <span class="cs-form-required" aria-hidden="true">*</span></label><input id="cs-lastName" type="text" required="" class="cs-form-input" autoComplete="family-name" name="lastName"/></div></div><div class="cs-form-row"><div class="cs-form-field"><label class="cs-form-label" for="cs-email">Email <span class="cs-form-required" aria-hidden="true">*</span></label><input id="cs-email" type="email" required="" class="cs-form-input" autoComplete="email" name="email"/></div><div class="cs-form-field"><label class="cs-form-label" for="cs-phone">Phone</label><input id="cs-phone" type="tel" class="cs-form-input" autoComplete="tel" name="phone"/></div></div><div class="cs-form-field"><label class="cs-form-label" for="cs-message">Message <span class="cs-form-required" aria-hidden="true">*</span></label><textarea id="cs-message" name="message" required="" rows="5" class="cs-form-textarea"></textarea></div><div class="cs-form-honeypot"><label for="cs-company">Company</label><input id="cs-company" type="text" tabindex="-1" autoComplete="off" name="company"/></div><button type="submit" class="cs-btn cs-btn-primary" style="margin-top:8px">Send Message</button></form></div></div></div></section><!--$--><!--/$--></main><footer class="cs-footer"><div class="cs-container cs-footer-grid"><div><span class="cs-footer-logo"><img alt="Michael J. Bayard Construction ADR" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:contain;object-position:left center;color:transparent" sizes="200px" srcSet="/_next/imag