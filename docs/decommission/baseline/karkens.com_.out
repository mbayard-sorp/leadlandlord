ness"},"description":"Have holes that need patch and paint or new sections added. Our team has the skills to repair any drywall issue you might have.","url":"https://karkens.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Garage Painting","provider":{"@id":"https://karkens.com/#localbusiness"},"description":"We handle surface prep before we paint, so every garage door is smooth and ready for a lasting professional looking finish.","url":"https://karkens.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"Gate Painting","provider":{"@id":"https://karkens.com/#localbusiness"},"description":"Don't let the Arizona sun keep your gate looking damaged. Our expert team will bring life back to sun-bleached wood or protect your iron with the best materials for lasting results.","url":"https://karkens.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"Service","name":"and More!","provider":{"@id":"https://karkens.com/#localbusiness"},"description":"If you don't see it on our site, ask us and our friendly staff will get back to you ASAP. We love our work and want you to love it too.","url":"https://karkens.com/#contact"}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"AggregateOffer","offers":[{"@type":"Offer","name":"Exterior Painting","description":"Limited time discount","price":30,"priceCurrency":"USD","itemOffered":{"@type":"Service","name":"Exterior Painting"}},{"@type":"Offer","name":"Interior Painting","description":"Limited time discount","price":20,"priceCurrency":"USD","itemOffered":{"@type":"Service","name":"Interior Painting"}}],"priceCurrency":"USD","lowPrice":20,"highPrice":30}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Family Owned","acceptedAnswer":{"@ty